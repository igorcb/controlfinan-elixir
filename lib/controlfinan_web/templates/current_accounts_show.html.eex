<% e = @entry %>
<h1 class="mb-6 text-2xl font-semibold">Lançamento</h1>

<div class="card">
  <dl class="grid gap-4 text-sm sm:grid-cols-2">
    <div>
      <dt class="text-slate-500">Data</dt>
      <dd class="font-medium"><%= date_br(e) %></dd>
    </div>
    <div>
      <dt class="text-slate-500">Tipo</dt>
      <dd class="font-medium"><%= type_name(e) %></dd>
    </div>
    <div>
      <dt class="text-slate-500">Conta</dt>
      <dd class="font-medium"><%= name_account(e) %></dd>
    </div>
    <div>
      <dt class="text-slate-500">Categoria</dt>
      <dd class="font-medium"><%= name_cost(e) %></dd>
    </div>
    <div>
      <dt class="text-slate-500">Valor</dt>
      <dd class="font-medium <%= if credit?(e), do: "text-emerald-700", else: "text-red-700" %>"><%= currency(signed_cents(e)) %></dd>
    </div>
    <div>
      <dt class="text-slate-500">Histórico</dt>
      <dd class="font-medium"><%= if historic_text(e) != "", do: h(historic_text(e)), else: "—" %></dd>
    </div>
  </dl>

  <div class="mt-6 flex flex-wrap gap-3">
    <a class="btn-primary" href="/current_accounts/<%= e.id %>/edit">Editar</a>
    <a class="btn-secondary" href="/current_accounts">Voltar</a>
    <form class="button_to" method="post" action="/current_accounts/<%= e.id %>" data-confirm="Excluir este lançamento?"><input type="hidden" name="_method" value="delete" autocomplete="off"><button class="btn-danger" type="submit">Excluir</button><input type="hidden" name="authenticity_token" value="<%= h(@csrf) %>" autocomplete="off"></form>
  </div>
</div>
