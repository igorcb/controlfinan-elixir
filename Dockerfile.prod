# Production image: a mix release (with ERTS) on debian slim, same glibc as the build image.
FROM python:3.12-slim AS css
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL --retry 6 --retry-all-errors --retry-delay 5 -o /usr/local/bin/tailwindcss \
       https://github.com/tailwindlabs/tailwindcss/releases/download/v4.3.3/tailwindcss-linux-x64 \
    && chmod +x /usr/local/bin/tailwindcss
WORKDIR /src
COPY assets ./assets
COPY lib/controlfinan_web/templates ./lib/controlfinan_web/templates
RUN tailwindcss -i assets/app.tailwind.css -o priv/static/css/app.css --minify

FROM elixir:1.18-otp-27-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates && rm -rf /var/lib/apt/lists/*
ENV MIX_ENV=prod
WORKDIR /src
RUN mix local.hex --force && mix local.rebar --force
COPY mix.exs mix.lock ./
RUN mix deps.get --only prod && mix deps.compile
COPY config ./config
COPY lib ./lib
COPY priv ./priv
COPY --from=css /src/priv/static/css/app.css priv/static/css/app.css
RUN mix release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 openssl libncurses6 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
COPY --from=build /src/_build/prod/rel/controlfinan /app
USER 65534:65534
ENV HOME=/tmp RELEASE_TMP=/tmp
EXPOSE 8000
ENTRYPOINT ["/app/bin/controlfinan"]
CMD ["start"]
